<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_change_vendor" model="ir.ui.view">
        <field name="name">purchase.order.form.change.vendor</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_confirm']" position="before">
                <button name="action_change_vendor"
                        string="Change Vendor"
                        type="object"
                        class="oe_highlight"
                        groups="nspl_change_vendor_in_validated_purchase.group_change_partner_po"
                        invisible="[( 'state', 'not in', ('purchase','done') )]"/>

            </xpath>
        </field>
    </record>
</odoo>
