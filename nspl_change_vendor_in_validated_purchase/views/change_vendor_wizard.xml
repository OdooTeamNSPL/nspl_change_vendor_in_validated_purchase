<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_change_vendor_wizard" model="ir.ui.view">
        <field name="name">change.vendor.wizard.form</field>
        <field name="model">change.vendor.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Vendor">
                <group>
                    <field name="partner_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="confirm_change" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_change_vendor_wizard" model="ir.actions.act_window">
        <field name="name">Change Vendor</field>
        <field name="res_model">change.vendor.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_journal_entry_form_custom" model="ir.ui.view">
    <field name="name">account.move.form.custom</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='line_ids']//field[@name='account_id']" position="after">
            <field name="partner_id"/>
        </xpath>
    </field>
</record>
</odoo>
